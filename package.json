{
  "name": "toledo-sync",
  "version": "1.2.1",
  "description": "Local-first KU Leuven Toledo course material synchronizer",
  "author": "Toledo Sync contributors",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "toledo-sync": "./src/linux-cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/linux-cli.mjs && node --check src/cli.mjs && node --check src/cli-i18n.mjs && node --check src/browser.mjs && node --check src/sync.mjs && node --check desktop/main.mjs && node --check desktop/preload.cjs && node --check desktop/renderer/app.js",
    "start": "node src/linux-cli.mjs",
    "desktop": "electron .",
    "make:win": "electron-builder --win nsis portable --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "license": "MIT",
  "build": {
    "appId": "be.kuleuven.toledosync",
    "productName": "Toledo Sync",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**/*",
      "desktop/**/*",
      "src/**/*",
      "package.json",
      "README.md",
      "docs/**/*"
    ],
    "icon": "assets/toledo-sync.ico",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/toledo-sync.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
