{
  "name": "toledo-sync",
  "version": "1.3.0",
  "description": "Local-first KU Leuven Toledo course material synchronizer",
  "desktopName": "toledo-sync",
  "author": "Toledo Sync contributors",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "toledo-sync": "./src/linux-cli.mjs"
  },
  "scripts": {
    "test": "node --test test/course-content.test.mjs test/linux-cli.test.mjs test/utils.test.mjs",
    "check": "node --check src/linux-cli.mjs && node --check src/cli.mjs && node --check src/cli-i18n.mjs && node --check src/browser.mjs && node --check src/course-content.mjs && node --check src/sync.mjs && node --check desktop/main.mjs && node --check desktop/preload.cjs && node --check desktop/renderer/app.js",
    "start": "node src/linux-cli.mjs",
    "desktop": "electron .",
    "make:win": "electron-builder --win nsis portable --publish never",
    "make:linux": "electron-builder --linux AppImage --publish never",
    "make:linux:portable": "electron-builder --linux tar.gz --publish never",
    "make:mac": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "license": "MIT",
  "build": {
    "appId": "be.kuleuven.toledosync",
    "productName": "Toledo Sync",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.mjs",
    "files": [
      "assets/**/*",
      "desktop/**/*",
      "src/**/*",
      "package.json",
      "README.md",
      "docs/**/*"
    ],
    "linux": {
      "icon": "assets/toledo-sync.svg",
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "synopsis": "KU Leuven Toledo course material sync",
      "description": "Synchronize course materials from KU Leuven Toledo to a local study folder.",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/toledo-sync.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "icon": "assets/toledo-sync.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Toledo.Sync-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
