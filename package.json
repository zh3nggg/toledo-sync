{
  "name": "toledo-sync",
  "version": "1.2.0",
  "description": "Local-first KU Leuven Toledo course material synchronizer",
  "author": "Toledo Sync contributors",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "toledo-sync": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/cli.mjs && node --check src/sync.mjs && node --check desktop/main.mjs && node --check desktop/preload.cjs && node --check desktop/renderer/app.js",
    "start": "node src/cli.mjs",
    "desktop": "electron .",
    "make:win": "electron-builder --win nsis portable --publish never",
    "make:mac": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "license": "MIT",
  "build": {
    "appId": "be.kuleuven.toledosync",
    "productName": "Toledo Sync",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.mjs",
    "files": [
      "assets/**/*",
      "desktop/**/*",
      "src/**/*",
      "package.json",
      "README.md",
      "docs/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/toledo-sync.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/toledo-sync.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Toledo.Sync-${version}-macOS-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  }
}
